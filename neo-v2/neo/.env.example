# NEO Environment Variables
# Copy to .env และใส่ค่าจริง

# ─── Telegram ───
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ─── AI APIs ───
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=

# ─── Ollama (local) ───
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5

# ─── Database ───
DATABASE_URL=postgresql://neo_user:password@localhost:5432/neo_db

# ─── Redis ───
REDIS_URL=redis://localhost:6379

# ─── Server ───
PORT=3000
NEO_DOMAIN=neo.z-node.cc
NODE_ENV=development

# ─── Auth (REQUIRED — NEO จะ crash ถ้าไม่ set) ───
NEO_PASSWORD=your_strong_password_here
NEO_SESSION_SECRET=at_least_32_chars_random_string_here   # openssl rand -hex 32

# ─── Telegram Security ───
NEO_TELEGRAM_CHAT_ID=123456789   # Numeric ID จาก @userinfobot — whitelist ใครคุยกับ bot ได้

# ─── Rate Limiting ───
RATE_LIMIT_PER_MIN=30   # Max requests ต่อ IP ต่อนาทีสำหรับ /api/chat/stream (default 30)
